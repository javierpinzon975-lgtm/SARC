DB_URL=jdbc:mysql://localhost:3306/proyecto_sarc_api?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
ADMIN_PASSWORD=replace-with-a-separate-admin-provisioning-password

# Optional SMTP settings for email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# Optional Twilio settings for SMS and WhatsApp reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Comma-separated list of trusted frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
